{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ditero-web",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ditero.app",
      "custom_domain": true
    },
    {
      "pattern": "www.ditero.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
