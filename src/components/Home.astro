---
import SiteLayout from '../layouts/SiteLayout.astro';
import Capture from './Capture.astro';
import { copy, extra, links, version, type LinkKey, type Locale } from '../content';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const x = extra[locale];
const a = t.access;
const label = (key: 'setup' | 'release' | 'guide') => a.labels[key];
const publicRows: { row: typeof a.public.web; link?: [LinkKey, 'setup' | 'release' | 'guide'] }[] = [
  { row: a.public.web, link: ['deploy', 'setup'] },
  { row: a.public.android, link: ['release', 'release'] },
  { row: a.public.desktop, link: ['release', 'release'] },
  { row: a.public.ios },
];
const devRows: { row: typeof a.dev.cli; link: [LinkKey, 'guide'] }[] = [
  { row: a.dev.cli, link: ['cli', 'guide'] },
  { row: a.dev.tui, link: ['tui', 'guide'] },
  { row: a.dev.api, link: ['api', 'guide'] },
  { row: a.dev.mcp, link: ['mcp', 'guide'] },
];
const categoryLinks: Record<string, LinkKey> = { access: 'api' };
const cap = { desktopAlt: t.capture.desktopAlt, mobileAlt: t.capture.mobileAlt, heroAlt: t.capture.heroAlt, open: t.capture.open };
const proofHeights = { 'task-detail': 470, 'recurrence-reminders': 470 };
const mobileProofHeights = { 'task-detail': 524, 'recurrence-reminders': 398 };
const proofs = (['task-detail', 'recurrence-reminders'] as const).map(id => ({
  id, ...t.gallery.items[id], ...t.features.proof[id], height: proofHeights[id],
}));
const dashboard = t.features.proof.dashboard;
---
<SiteLayout locale={locale}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title"><span>{t.hero.line1}</span> <span>{t.hero.line2}</span></h1>
      <p class="lead">{x.ui.heroIntro}</p>
      <div class="actions">
        <a class="button" href={links.deploy}>{t.hero.primary}</a>
        <a class="text-link" href="#access">{t.hero.apps}</a>
      </div>
      <div class="hero-meta">
        <a class="status small" href={links.release}>{t.hero.status}{' '}<bdi>{version}</bdi></a>
      </div>
    </div>
    <div class="hero-media"><Capture name="list" variant="hero" {...cap} /></div>
  </section>

  <div class="proofs wrap">
    {proofs.map((proof) => (
      <section class={`proof proof-${proof.id}`} aria-labelledby={`proof-${proof.id}-title`}>
        <div class="proof-copy">
          <h2 id={`proof-${proof.id}-title`}>{proof.title}</h2>
          <p>{proof.text}</p>
        </div>
        <figure class="proof-media">
          {(['light', 'dark'] as const).map(theme => (
            <div class={`shots shots-${theme}`}>
              <a class="proof-link proof-desktop" href={`/images/gallery/${proof.id}${theme === 'dark' ? '-dark' : ''}.png`} aria-label={`${t.capture.open}: ${proof.alt}`}>
                <span class="proof-excerpts">
                  <img src={`/images/proof/${proof.id === 'task-detail' ? 'sharing' : 'recurrence'}-context-${theme}.webp`} width="439" height="92" alt="" loading="lazy" decoding="async" />
                  <img src={`/images/proof/${proof.id}-${theme}.webp`} width="439" height={proof.height} alt={proof.alt} loading="lazy" decoding="async" />
                </span>
              </a>
              <a class="proof-link proof-mobile" href={`/images/gallery/${proof.id}-mobile-${theme}.png`} aria-label={`${t.capture.open}: ${proof.alt}`}>
                <span class="proof-excerpts">
                  <img src={`/images/proof/${proof.id === 'task-detail' ? 'sharing' : 'recurrence'}-context-mobile-${theme}.webp`} width="390" height="100" alt="" loading="lazy" decoding="async" />
                  <img src={`/images/proof/${proof.id}-mobile-${theme}.webp`} width="390" height={mobileProofHeights[proof.id]} alt={proof.alt} loading="lazy" decoding="async" />
                </span>
              </a>
            </div>
          ))}
        </figure>
      </section>
    ))}
    <section id="dashboard" class="proof proof-dashboard" aria-labelledby="dashboard-title">
      <div class="proof-copy"><h2 id="dashboard-title">{dashboard.title}</h2><p>{dashboard.text}</p></div>
      <div class="proof-media"><Capture name="dashboard" variant="wide" {...cap} desktopAlt={t.capture.dashboardAlt} compactAlt={t.capture.dashboardCompactAlt} /></div>
    </section>
  </div>

  <section id="assistant" class="assistant wrap" aria-labelledby="assistant-title">
    <div class="assistant-copy">
      <h2 id="assistant-title">{x.ai.title}</h2><p>{x.ai.intro}</p>
      <p class="source">{x.ai.shortSource}</p>
      <div class="assistant-links">
        <a class="text-link" href={links.mcp}>{x.ai.link}</a>
        <details class="fold"><summary aria-label={`${x.ui.details}: ${x.ai.title}`}>{x.ui.details}</summary><ul class="plain">{x.ai.points.map(point => <li>{point}</li>)}</ul></details>
      </div>
    </div>
    <figure class="request">
      <figcaption>{x.ai.exampleLabel}</figcaption>
      <blockquote><p>{x.ai.example}</p></blockquote>
      <p class="plan-label" id="plan-label">{x.ai.resultLabel}</p>
      <ul class="plan" aria-labelledby="plan-label">{x.ai.results.map(result => <li><span class="plan-title">{result.title}</span><span class="plan-detail">{result.detail}</span></li>)}</ul>
    </figure>
  </section>

  <section id="features" class="features wrap" aria-labelledby="features-title">
    <div class="features-head"><h2 id="features-title">{t.features.title}</h2><p>{t.features.intro}</p></div>
    <div class="feature-explorer" role="group" aria-label={x.ui.groups}>
      {[x.features.groups.slice(0, 4), x.features.groups.slice(4)].map(groups => (
        <div class="feature-column">{groups.map(group => (
        <details class="feature-group" id={`group-${group.id}`} name="features">
          <summary><span class="feature-summary"><span>{group.title}</span><span class="feature-preview">{group.summary}</span></span></summary>
          <div class="feature-body">
            <div><ul class="feature-items">{group.items.map(item => <li>{item}</li>)}</ul><a class="text-link" href={links[categoryLinks[group.id] ?? 'docs']}>{x.ui.docs}</a></div>
          </div>
        </details>
        ))}</div>
      ))}
    </div>
  </section>

  <section id="access" class="apps wrap" aria-labelledby="apps-title">
    <div class="apps-heading"><h2 id="apps-title">{a.title}</h2><p>{a.intro}</p></div>
    <div class="apps-body">
      {([
        { title: a.publicTitle, rows: publicRows },
        { title: a.devTitle, rows: devRows },
      ]).map(({ title, rows }) => (
        <div class="apps-stack">
          <h3 class="group">{title}</h3>
          <div class="clients">
            {rows.map(({ row, link }) => (
              <article class="public-client">
                {link ? <>
                  <details class="client-details">
                    <summary><span class="client-heading"><span class="client-name"><span class="name">{row.name}</span><span class="client-chevron" aria-hidden="true" /></span><span class="state">{row.state}</span></span></summary>
                    <p>{row.text}</p>
                    {(['cli', 'tui', 'mcp'] as const).some(key => key === link[0]) && <p>{x.ai.source}</p>}
                  </details>
                  <a class="text-link client-action" href={links[link[0]]} aria-label={`${label(link[1])}: ${row.name}`}>{label(link[1])}</a>
                </> : <div class="client-heading"><span class="name">{row.name}</span><span class="state">{row.state}</span></div>}
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
    <p class="small apps-note">{a.note}</p>
  </section>

  <section id="self-host" class="host" aria-labelledby="host-title">
    <div class="wrap host-grid">
      <div class="host-copy"><h2 id="host-title"><img class="host-mark" src="/brand/ditero-felt-96.webp" width="32" height="32" alt="" loading="lazy" decoding="async" /><span>{t.server.title}</span></h2><p>{t.server.text}</p><div class="actions"><a class="button" href={links.deploy}>{t.server.link}</a><a class="text-link" href={links.docs}>{t.server.docs}</a></div></div>
      <div class="host-details"><ol class="steps" role="list">{x.setup.steps.map(step => <li>{step}</li>)}</ol><p class="encryption-note">{t.server.encryption}</p></div>
    </div>
  </section>

  <section id="support" class="support wrap" aria-labelledby="support-title">
    <h2 id="support-title">{t.support.title}</h2>
    <div><p>{t.support.text}</p><p class="actions"><a class="text-link" href={links.support}>{t.support.kofi}</a><a class="text-link" href={links.sponsor}>{t.support.sponsor}</a></p></div>
  </section>
</SiteLayout>
