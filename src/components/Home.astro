---
import SiteLayout from '../layouts/SiteLayout.astro';
import Capture from './Capture.astro';
import FeatureText from './FeatureText.astro';
import { copy, extra, links, version, type LinkKey, type Locale } from '../content';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const x = extra[locale];
const a = t.access;
const label = (key: 'setup' | 'release' | 'guide') => a.labels[key];
const publicRows: { row: typeof a.public.web; link?: [LinkKey, 'setup' | 'release' | 'guide'] }[] = [
  { row: a.public.web, link: ['deploy', 'setup'] },
  { row: a.public.android, link: ['release', 'release'] },
  { row: a.public.desktop, link: ['release', 'release'] },
  { row: a.public.ios },
];
const devRows: { row: typeof a.dev.cli; link: [LinkKey, 'guide'] }[] = [
  { row: a.dev.cli, link: ['cli', 'guide'] },
  { row: a.dev.tui, link: ['tui', 'guide'] },
  { row: a.dev.api, link: ['api', 'guide'] },
  { row: a.dev.mcp, link: ['mcp', 'guide'] },
];
const cap = { desktopAlt: t.capture.desktopAlt, mobileAlt: t.capture.mobileAlt, open: t.capture.open };
type ProofId = 'task-detail' | 'recurrence-reminders';
type ProofAssets = {
  context: 'sharing' | 'recurrence';
  desktop: { width: number; contextHeight: number; height: number };
  mobile: { width: number; contextHeight: number; height: number };
};
const proofAssets = {
  'task-detail': {
    context: 'sharing',
    desktop: { width: 439, contextHeight: 92, height: 528 },
    mobile: { width: 390, contextHeight: 96, height: 548 },
  },
  'recurrence-reminders': {
    context: 'recurrence',
    desktop: { width: 439, contextHeight: 92, height: 470 },
    mobile: { width: 390, contextHeight: 100, height: 398 },
  },
} satisfies Record<ProofId, ProofAssets>;
const proofs = (['task-detail', 'recurrence-reminders'] as const).map(id => ({
  id, ...t.gallery.items[id], ...t.features.proof[id], assets: proofAssets[id],
}));
const dashboard = t.features.proof.dashboard;
const featureArtwork: Record<string, string> = { lists: 'lists', routines: 'routines', reminders: 'reminders', views: 'views', files: 'files', recovery: 'history', access: 'access', custom: 'custom' };
const productCopy = (text: string) => text.split(/((?:و)?(?:Docker Compose|Helm|Web-App)[.,;:!?،؛؟]?)/g).map(part => {
  const term = /^(و?)(Docker Compose|Helm|Web-App)([.,;:!?،؛؟]?)$/.exec(part);
  return term ? { before: term[1], name: term[2], after: term[3] } : part;
});
---
<SiteLayout locale={locale} hero>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy wrap">
      <h1 id="hero-title"><span>{t.hero.line1}</span> <span>{t.hero.line2}</span></h1>
      <p class="lead">{x.ui.heroIntro}</p>
      <div class="actions">
        <a class="button" href={links.deploy}>{t.hero.primary}</a>
        <a class="text-link" href="#access">{t.hero.apps}</a>
      </div>
      <div class="hero-meta">
        <p class="platforms small">{x.ui.platforms.split(/(CLI|TUI|MCP)/g).map(part => ['CLI', 'TUI', 'MCP'].includes(part) ? <bdi>{part}</bdi> : part)}</p>
        <a class="status small" href={links.release}>{t.hero.status}{' '}<bdi>{version}</bdi></a>
      </div>
    </div>
    <div class="hero-media"><Capture name="list" variant="hero" {...cap} /></div>
  </section>

  <section id="product-tour" class="tour" aria-labelledby="tour-title">
    <header class="tour-header wrap">
      <h2 class="tour-heading" id="tour-title">{x.ui.tour}</h2>
    <fieldset class="tour-device">
      <legend class="sr-only">{x.ui.view}</legend>
      <input class="device-radio sr-only" type="radio" name="proof-device" id="proof-desktop" checked />
      <label class="device-choice" for="proof-desktop">{x.ui.desktop}</label>
      <input class="device-radio sr-only" type="radio" name="proof-device" id="proof-phone" />
      <label class="device-choice" for="proof-phone">{x.ui.phone}</label>
    </fieldset>
    </header>
    <fieldset class="tour-stage wrap">
      <legend class="sr-only">{x.ui.tour}</legend>
      {proofs.map((proof, index) => <>
        <input class={`tour-radio tour-choice-${index + 1}`} type="radio" name="product-tour" id={`tour-${proof.id}`} checked={index === 0} aria-controls={`panel-${proof.id}`} />
        <label class={`tour-choice tour-choice-${index + 1}`} for={`tour-${proof.id}`}>
          <span class="choice-title" id={`proof-${proof.id}-title`}>{proof.title}</span>
          <span class="choice-text">{proof.text}</span>
        </label>
        <div class="tour-panel" id={`panel-${proof.id}`} role="region" aria-labelledby={`proof-${proof.id}-title`}>
          <figure class="proof-media">
          {(['light', 'dark'] as const).map(theme => (
            <div class={`shots shots-${theme}`}>
              <a class="proof-link proof-desktop" href={`/images/gallery/${proof.id}${theme === 'dark' ? '-dark' : ''}.png`} aria-label={`${t.capture.open}: ${proof.alt}`}>
                <span class="proof-excerpts">
                  <img src={`/images/proof/${proof.assets.context}-context-${theme}.webp`} width={proof.assets.desktop.width} height={proof.assets.desktop.contextHeight} alt="" loading="lazy" decoding="async" />
                  <img src={`/images/proof/${proof.id}-${theme}.webp`} width={proof.assets.desktop.width} height={proof.assets.desktop.height} alt={proof.alt} loading="lazy" decoding="async" />
                </span>
              </a>
              <a class="proof-link proof-mobile" href={`/images/gallery/${proof.id}-mobile-${theme}.png`} aria-label={`${t.capture.open}: ${proof.alt}`}>
                <span class="proof-excerpts">
                  <img src={`/images/proof/${proof.assets.context}-context-mobile-${theme}.webp`} width={proof.assets.mobile.width} height={proof.assets.mobile.contextHeight} alt="" loading="lazy" decoding="async" />
                  <img src={`/images/proof/${proof.id}-mobile-${theme}.webp`} width={proof.assets.mobile.width} height={proof.assets.mobile.height} alt={proof.alt} loading="lazy" decoding="async" />
                </span>
              </a>
            </div>
          ))}
          </figure>
        </div>
      </>)}
      <input class="tour-radio tour-choice-3" type="radio" name="product-tour" id="tour-dashboard" aria-controls="panel-dashboard" />
      <label class="tour-choice tour-choice-3" for="tour-dashboard" id="dashboard">
        <span class="choice-title" id="dashboard-title">{dashboard.title}</span>
        <span class="choice-text">{dashboard.text}</span>
      </label>
      <div class="tour-panel tour-dashboard" id="panel-dashboard" role="region" aria-labelledby="dashboard-title">
        <Capture name="dashboard" variant="wide" {...cap} desktopAlt={t.capture.dashboardAlt} compactAlt={t.capture.dashboardCompactAlt} />
      </div>
    </fieldset>
  </section>

  <section id="assistant" class="assistant wrap" aria-labelledby="assistant-title">
    <div class="assistant-sheet">
      <header class="assistant-heading">
        <h2 id="assistant-title">{x.ai.title}</h2>
        <p>{x.ai.intro}</p>
      </header>
      <div class="assistant-example">
        <figure class="request">
          <figcaption>{x.ai.exampleLabel}</figcaption>
          <blockquote><p>{x.ai.example}</p></blockquote>
        </figure>
        <div class="assistant-plan">
          <div class="plan-heading">
            <p class="plan-label" id="plan-label">{x.ai.resultLabel}</p>
            <img class="assistant-robot" src="/images/assistant-robot.webp" width="56" height="56" alt="" loading="lazy" decoding="async" />
          </div>
          <ul class="plan" role="list" aria-labelledby="plan-label">
            {x.ai.results.map(result => (
              <li><span class="plan-title">{result.title}</span><span class="plan-detail">{result.detail}</span></li>
            ))}
          </ul>
        </div>
      </div>
      <footer class="assistant-links">
        <div class="assistant-actions">
          <a class="text-link" href={links.mcp}>{x.ai.link}</a>
          <p class="source small">{x.ai.shortSource}</p>
        </div>
        <details class="fold">
          <summary aria-label={`${x.ui.details}: ${x.ai.title}`}>{x.ui.details}</summary>
          <ul class="plain" role="list">{x.ai.points.map(point => <li>{point}</li>)}</ul>
        </details>
      </footer>
    </div>
  </section>

  <section id="features" class="features wrap" aria-labelledby="features-title">
    <header class="features-head">
      <h2 id="features-title">{t.features.title}</h2>
      <p>{t.features.intro}</p>
      <a class="text-link feature-guide" href={links.docs}>{x.ui.docs}</a>
    </header>
    <div class="feature-explorer" role="group" aria-label={x.ui.groups}>
      {x.features.groups.map(group => (
        <details class="feature-group" id={`group-${group.id}`} name="features">
          <summary>
            <span class="feature-summary">
              <span><FeatureText text={group.title} /></span>
              <span class="feature-preview"><FeatureText text={group.summary} /></span>
            </span>
          </summary>
          <div class:list={['feature-body', { 'feature-body-short': group.items.length <= 3 }]}>
            <span class="feature-mat" aria-hidden="true"><img class="feature-art" src={`/images/carousel/${featureArtwork[group.id]}.webp`} width="480" height="480" alt="" loading="lazy" decoding="async" /></span>
            <ul class="feature-items" role="list">{group.items.map(item => <li><FeatureText text={item} /></li>)}</ul>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section id="access" class="apps" aria-labelledby="apps-title">
    <div class="wrap apps-sheet">
    <header class="apps-heading">
      <h2 id="apps-title">{a.title}</h2>
      <p>{a.intro}</p>
    </header>
    <div class="apps-stack">
      <h3 class="group">{a.publicTitle}</h3>
      <div class="platform-strip">
        {publicRows.map(({ row, link }) => (
          <article class="platform-client">
            {link ? <>
              <details class="client-details">
                <summary>
                  <span class="client-heading">
                    <span class="client-name"><span class="name">{row.name}</span><span class="client-chevron" aria-hidden="true" /></span>
                    <span class="state">{row.state}</span>
                  </span>
                </summary>
                <p>{row.text}</p>
              </details>
              <a class="text-link client-action" href={links[link[0]]} aria-label={`${label(link[1])}: ${row.name}`}>{label(link[1])}</a>
            </> : <div class="client-heading"><span class="name">{row.name}</span><span class="state">{row.state}</span></div>}
          </article>
        ))}
      </div>
    </div>
    <div class="apps-stack tools-stack">
      <div class="group-head">
        <h3 class="group">{a.devTitle}</h3>
        <p class="tools-source small">{x.ai.source}</p>
      </div>
      <div class="tool-strip">
        {devRows.map(({ row, link }) => (
          <article class="tool-client">
            <details class="client-details">
              <summary>
                <span class="client-heading">
                  <span class="client-name"><bdi class="name tool-name">{row.name}</bdi><span class="client-chevron" aria-hidden="true" /></span>
                  <span class="state">{row.state}</span>
                </span>
              </summary>
              <p>{row.text}</p>
            </details>
            <a class="text-link client-action" href={links[link[0]]} aria-label={`${label(link[1])}: ${row.name}`}>{label(link[1])}</a>
          </article>
        ))}
      </div>
    </div>
    </div>
  </section>

  <section id="self-host" class="host" aria-labelledby="host-title">
    <div class="wrap host-grid">
      <div class="host-copy">
        <h2 id="host-title">{t.server.title}</h2>
        <p>{productCopy(t.server.text).map(part => typeof part === 'string' ? part : <span class="product-run">{part.before}<bdi class:list={{ 'product-term': part.name !== 'Web-App' }}>{part.name}</bdi>{part.after}</span>)}</p>
        <div class="actions">
          <a class="button" href={links.deploy}>{t.hero.primary}</a>
          <a class="text-link" href={links.docs}>{t.server.docs}</a>
        </div>
      </div>
      <div class="host-details">
        <div class="steps-mat"><ol class="steps" role="list">
          {x.setup.steps.map(step => (
            <li><span>{productCopy(step).map(part => typeof part === 'string' ? part : <span class="product-run">{part.before}<bdi class:list={{ 'product-term': part.name !== 'Web-App' }}>{part.name}</bdi>{part.after}</span>)}</span></li>
          ))}
        </ol></div>
        <p class="encryption-note"><FeatureText text={t.server.encryption} /></p>
      </div>
    </div>
  </section>

  <section id="support" class="support wrap" aria-labelledby="support-title">
    <div class="support-copy"><h2 id="support-title">{t.support.title}</h2><p>{t.support.text}</p></div>
    <p class="actions"><a class="text-link" href={links.support}>{t.support.kofi}</a><a class="text-link" href={links.sponsor}>{t.support.sponsor}</a></p>
  </section>
</SiteLayout>

<script>
  const revealTourFragment = (): void => {
    const id = location.hash.slice(1);
    if (!id) return;
    const target = document.getElementById(id);
    if (!target) return;
    const panel = target.closest<HTMLElement>('.tour-panel');
    const choice = target.closest<HTMLLabelElement>('.tour-choice');
    const radio = target instanceof HTMLInputElement && target.matches('.tour-radio') ? target : choice ? document.getElementById(choice.htmlFor) : panel ? [...document.querySelectorAll<HTMLInputElement>('.tour-radio')].find(input => input.getAttribute('aria-controls') === panel.id) : null;
    if (radio instanceof HTMLInputElement && radio.type === 'radio') radio.checked = true;
  };
  revealTourFragment();
  window.addEventListener('hashchange', revealTourFragment);
</script>
