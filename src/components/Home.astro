---
import SiteLayout from '../layouts/SiteLayout.astro';
import { copy, links, type Locale } from '../content';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
---
<SiteLayout locale={locale}>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.headline.split('\n').map(line => <span>{line}</span>)}</h1>
      <p class="intro">{t.intro}</p>
      <div class="actions"><a class="button primary" href={links.deploy}>{t.primary}<span aria-hidden="true">↗</span></a><a class="text-link" href={links.project}>{t.secondary}<span aria-hidden="true">↗</span></a></div>
      <p class="alpha"><span>{t.alpha}</span><br />{t.alphaText}</p>
    </div>
    <figure class="illustration">
      <div class="sample">
        <div class="sample-sidebar"><p class="sample-brand"><img src="/icon.png" width="28" height="28" alt="" />Ditero</p><p class="sample-space">{t.space}</p><ul><li class="selected">{t.today}<span>3</span></li><li>{t.shopping}</li><li>{t.project}</li><li>{t.chores}</li></ul><div class="people" aria-hidden="true"><span>A</span><span>S</span><span>J</span></div></div>
        <div class="sample-main"><div class="sample-heading"><p>{t.shared}</p><h2>{t.today}</h2></div><ul class="sample-tasks">{t.tasks.map(task => <li class:list={{ done: task.done }}><span class="task-check" aria-hidden="true">{task.done ? '✓' : ''}</span><div><strong>{task.name}</strong><small>{task.detail}</small><span class="task-tag">{task.tag}</span></div></li>)}</ul><p class="sample-note">{t.progress}</p></div>
      </div>
      <figcaption>{t.illustration}</figcaption>
    </figure>
  </section>
  <section id="features" class="features wrap">
    <div class="section-heading"><h2>{t.sectionTitle.split('\n').map(line => <span>{line}</span>)}</h2><p>{t.sectionIntro}</p></div>
    <div class="feature-grid">{t.featureItems.map((item, index) => <article><span class="feature-mark" aria-hidden="true">{['✓', '↻', '+', 'Aa'][index]}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
  </section>
  <section class="ownership">
    <div class="wrap ownership-inner"><div><p class="eyebrow">{locale === 'de' ? 'Quelloffen. Selbst gehostet.' : 'Open source. Self-hosted.'}</p><h2>{t.ownershipTitle.split('\n').map(line => <span>{line}</span>)}</h2></div><div><p class="ownership-lead">{t.ownershipText}</p><a class="text-link" href={links.deploy}>{t.ownershipLink}<span aria-hidden="true">↗</span></a><p class="fine-print">{t.ownershipNote}</p></div></div>
  </section>
  <section id="get-started" class="release wrap"><div><p class="eyebrow">v0.0.1-alpha.2</p><h2>{t.releaseTitle}</h2><p>{t.releaseText}</p><p class="fine-print">{t.releaseNote}</p></div><div class="release-actions"><a class="button primary" href={links.release}>{t.releaseLink}<span aria-hidden="true">↗</span></a><a class="text-link" href={links.docs}>{t.releaseDocs}<span aria-hidden="true">↗</span></a></div></section>
</SiteLayout>
