---
import SiteLayout from '../layouts/SiteLayout.astro';
import { locales, localeInfo, pageUrl } from '../content';
---
<SiteLayout locale="en" title="Page not found" description="This page could not be found." noindex={true}>
  <section class="document">
    <h1>Page not found</h1>
    <p class="lead">We could not find the page you requested.</p>
    <ul class="plain">{locales.map(l => <li><a lang={l} href={pageUrl(l)}>{localeInfo[l].name}</a></li>)}</ul>
  </section>
</SiteLayout>
