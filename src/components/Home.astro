---
import SiteLayout from '../layouts/SiteLayout.astro';
import Capture from './Capture.astro';
import { copy, extra, links, type LinkKey, type Locale } from '../content';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const x = extra[locale];
const a = t.access;
const label = (key: 'setup' | 'release' | 'guide') => a.labels[key];
const publicRows: { row: typeof a.public.web; link?: [LinkKey, 'setup' | 'release' | 'guide'] }[] = [
  { row: a.public.web, link: ['deploy', 'setup'] },
  { row: a.public.android, link: ['release', 'release'] },
  { row: a.public.desktop, link: ['release', 'release'] },
  { row: a.public.ios },
];
const devRows: { row: typeof a.dev.cli; link: [LinkKey, 'guide'] }[] = [
  { row: a.dev.cli, link: ['cli', 'guide'] },
  { row: a.dev.tui, link: ['tui', 'guide'] },
  { row: a.dev.api, link: ['api', 'guide'] },
  { row: a.dev.mcp, link: ['mcp', 'guide'] },
];
const carouselLinks: Record<string, LinkKey> = { access: 'api' };
const cap = { desktopAlt: t.capture.desktopAlt, mobileAlt: t.capture.mobileAlt, open: t.capture.open };
const dashboard = t.features.items[2];
const art = (id: string) => ({ src: `/images/carousel/${id}.webp`, srcset: `/images/carousel/${id}.webp 480w, /images/carousel/${id}-720.webp 720w` });
const [assistantSource, ...assistantCaveats] = [x.ai.points[3], ...x.ai.points.slice(0, 3)];
---
<SiteLayout locale={locale}>
  <div class="wrap">
    <section class="stage hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title"><span>{t.hero.line1}</span> <span>{t.hero.line2}</span></h1>
        <p class="lead">{x.ui.heroIntro}</p>
        <div class="actions">
          <a class="button" href={links.deploy}>{t.hero.primary}</a>
          <a class="text-link" href="#access">{t.hero.apps}</a>
        </div>
        <p class="status">{t.hero.status}</p>
      </div>
      <div class="hero-media">
        <Capture name="list" variant="hero" {...cap} />
        <img class="tile hero-tile" {...art('lists')} sizes="(max-width: 800px) 112px, 224px" alt="" width="720" height="720" loading="eager" decoding="async" />
      </div>
    </section>
  </div>

  <section id="features" class="features" aria-labelledby="features-title" data-carousel data-of={x.ui.of} data-label={x.carousel.label}>
    <div class="wrap">
      <div class="features-head">
        <h2 id="features-title">{t.features.title}</h2>
        <p>{t.features.intro}</p>
      </div>
      <div class="tabs" role="group" aria-label={x.ui.groups} data-controls hidden>
        {x.carousel.groups.map(group => <button type="button" data-tab>{group.tab}</button>)}
      </div>
      <div class="track" data-track>
        {x.carousel.groups.map(group => (
          <article class="pane" id={`group-${group.id}`} data-pane data-title={group.title}>
            <img class="plate" {...art(group.id)} sizes="(max-width: 800px) 176px, 260px" alt="" width="720" height="720" loading="lazy" decoding="async" />
            <div class="pane-body">
              <h3>{group.title}</h3>
              <ul class="key">{group.items.slice(0, 2).map(item => <li>{item}</li>)}</ul>
              {group.items.length > 2 && (
                <details class="fold">
                  <summary>{x.ui.details}</summary>
                  <ul class="plain">{group.items.slice(2).map(item => <li>{item}</li>)}</ul>
                </details>
              )}
              <a class="text-link" href={links[carouselLinks[group.id] ?? 'docs']}>{x.ui.docs}</a>
            </div>
          </article>
        ))}
      </div>
      <p class="visually-hidden" aria-live="polite" data-status></p>
      <p class="small features-note">{x.carousel.note}</p>
    </div>
  </section>

  <section id="dashboard" class="dashboard wrap" aria-labelledby="dashboard-title">
    <div class="dash">
      <div class="dash-copy">
        <h2 id="dashboard-title">{dashboard.title}</h2>
        <p>{dashboard.text}</p>
      </div>
      <div class="dash-media">
        <Capture name="dashboard" variant="wide" {...cap} desktopAlt={t.capture.dashboardAlt} />
        <img class="tile dash-tile" {...art('views')} sizes="112px" alt="" width="720" height="720" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section id="access" class="apps wrap" aria-labelledby="apps-title">
    <div class="apps-aside">
      <h2 id="apps-title">{a.title}</h2>
      <div class="stage phone-stage">
        <Capture name="list" variant="phone" {...cap} />
      </div>
      <div class="phone-note">
        <h3>{t.mobile.title}</h3>
        <details class="fold">
          <summary>{x.ui.details}</summary>
          <p>{t.mobile.text}</p>
        </details>
        <a class="text-link" href={links.release}>{t.mobile.link}</a>
      </div>
    </div>
    <div class="apps-main">
      <h3 class="group">{a.publicTitle}</h3>
      <div class="clients">
        {publicRows.map(({ row, link }) => (
          <details class="client">
            <summary><span class="name">{row.name}</span><span class="state">{row.state}</span></summary>
            <p>{row.text}{link && <> <a href={links[link[0]]}>{label(link[1])}</a></>}</p>
          </details>
        ))}
      </div>
      <h3 class="group">{a.devTitle}</h3>
      <div class="clients">
        {devRows.map(({ row, link }) => (
          <details class="client">
            <summary><span class="name">{row.name}</span><span class="state">{row.state}</span></summary>
            <p>{row.text} <a href={links[link[0]]}>{label(link[1])}</a></p>
          </details>
        ))}
      </div>
      <details class="fold">
        <summary>{x.ui.details}</summary>
        <p>{a.intro}</p>
      </details>
      <p class="small">{a.note}</p>
    </div>
  </section>

  <section id="assistant" class="assistant wrap" aria-labelledby="assistant-title">
    <div class="assistant-copy">
      <h2 id="assistant-title">{x.ai.title}</h2>
      <p>{x.ai.intro}</p>
      <p class="source"><span class="state">{a.dev.mcp.state}</span> {assistantSource}</p>
      <details class="fold">
        <summary>{x.ui.details}</summary>
        <ul class="plain">{assistantCaveats.map(point => <li>{point}</li>)}</ul>
      </details>
      <a class="text-link" href={links.mcp}>{x.ai.link}</a>
    </div>
    <figure class="request">
      <figcaption>{x.ai.exampleLabel}</figcaption>
      <blockquote><p>{x.ai.example}</p></blockquote>
      <p class="plan-label" id="plan-label">{x.ai.resultLabel}</p>
      <ul class="plan" aria-labelledby="plan-label">
        {x.ai.results.map(result => <li><span class="plan-title">{result.title}</span><span class="state">{result.detail}</span></li>)}
      </ul>
    </figure>
  </section>

  <section class="band host" aria-labelledby="host-title">
    <div class="wrap host-grid">
      <div class="host-copy">
        <h2 id="host-title">{t.server.title}</h2>
        <ol class="steps" role="list">{x.setup.steps.map(step => <li>{step}</li>)}</ol>
        <div class="actions">
          <a class="button" href={links.deploy}>{t.server.link}</a>
          <a class="text-link" href={links.docs}>{t.server.docs}</a>
        </div>
        <details class="fold">
          <summary>{x.ui.details}</summary>
          <p>{t.server.text}</p>
        </details>
      </div>
      <div class="host-caveat">
        <img class="tile" {...art('files')} sizes="(max-width: 800px) 120px, 176px" alt="" width="720" height="720" loading="lazy" decoding="async" />
        <p>{t.server.encryption}</p>
      </div>
    </div>
  </section>

  <section id="support" class="support" aria-labelledby="support-title">
    <div class="wrap support-grid">
      <h2 id="support-title">{t.support.title}</h2>
      <div>
        <p class="support-text">{t.support.text}</p>
        <p class="actions"><a class="button" href={links.support}>{t.support.kofi}</a><a class="text-link" href={links.sponsor}>{t.support.sponsor}</a></p>
      </div>
    </div>
  </section>
</SiteLayout>
